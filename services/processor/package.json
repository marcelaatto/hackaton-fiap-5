{
  "name": "@hackaton/processor",
  "version": "1.0.0",
  "description": "Worker de processamento de vídeos com FFmpeg",
  "main": "src/worker.js",
  "scripts": {
    "start": "node src/worker.js",
    "dev": "nodemon src/worker.js",
    "test": "jest --coverage --forceExit"
  },
  "dependencies": {
    "@hackaton/shared": "*",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/unit/**/*.test.js"],
    "coverageDirectory": "coverage",
    "coverageReporters": ["lcov", "text", "text-summary"],
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
