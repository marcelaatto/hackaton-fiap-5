{
  "name": "@hackaton/api",
  "version": "1.0.0",
  "description": "API REST do sistema de processamento de vídeos",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "test": "jest --coverage --forceExit",
    "test:bdd": "jest tests/bdd/ --forceExit"
  },
  "dependencies": {
    "@hackaton/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/integration/**/*.test.js",
      "**/tests/bdd/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["lcov", "text", "text-summary"],
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
